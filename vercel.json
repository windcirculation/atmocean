{
    "version": 2,
    "builds": [
      {
        "src": "run.py",
        "use": "@vercel/python"
      }
    ],
    "routes": [
      {
        "src": "/api/run",
        "dest": "run.py"
      }
    ],
    "crons": [
      {
        "path": "/api/run",
        "schedule": "0 9 * * *"
      }
    ]
}
